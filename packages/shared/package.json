{
  "name": "@gedatou/shared",
  "type": "module",
  "version": "0.5.2",
  "description": "Shared data model and Remotion composition for the @gedatou/editor video editor",
  "author": "ge Datou (https://github.com/GGGLHHH)",
  "license": "MIT",
  "homepage": "https://github.com/GGGLHHH/Remotion-demo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GGGLHHH/Remotion-demo.git",
    "directory": "packages/shared"
  },
  "bugs": {
    "url": "https://github.com/GGGLHHH/Remotion-demo/issues"
  },
  "keywords": [
    "remotion",
    "video-editor",
    "composition"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./composition": {
        "types": "./dist/composition.d.mts",
        "import": "./dist/composition.mjs",
        "default": "./dist/composition.mjs"
      }
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./composition": "./src/composition/index.ts"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@remotion/captions": "4.0.491",
    "@remotion/gif": "4.0.491",
    "@remotion/google-fonts": "4.0.491",
    "@remotion/media": "4.0.491",
    "react": "^19.0.0",
    "remotion": "4.0.491"
  },
  "devDependencies": {
    "@remotion/captions": "catalog:remotion",
    "@remotion/gif": "catalog:remotion",
    "@remotion/google-fonts": "catalog:remotion",
    "@remotion/media": "catalog:remotion",
    "@types/react": "catalog:types",
    "react": "catalog:react",
    "remotion": "catalog:remotion",
    "tsdown": "catalog:cli",
    "typescript": "catalog:cli"
  }
}
