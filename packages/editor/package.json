{
  "name": "@gedatou/editor",
  "type": "module",
  "version": "0.5.2",
  "description": "Embeddable Remotion video editor React components — timeline, canvas, inspector; shadcn-authored, theme-able",
  "author": "ge Datou (https://github.com/GGGLHHH)",
  "license": "MIT",
  "homepage": "https://github.com/GGGLHHH/Remotion-demo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GGGLHHH/Remotion-demo.git",
    "directory": "packages/editor"
  },
  "bugs": {
    "url": "https://github.com/GGGLHHH/Remotion-demo/issues"
  },
  "keywords": [
    "remotion",
    "video-editor",
    "react",
    "timeline",
    "shadcn",
    "tailwind"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "imports": {
    "#lib/*": "./src/lib/*.ts",
    "#components/*": "./src/components/*.tsx",
    "#state/context": "./src/state/context.tsx",
    "#state/*": "./src/state/*.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./adapters": {
        "types": "./dist/adapters.d.mts",
        "import": "./dist/adapters.mjs",
        "default": "./dist/adapters.mjs"
      },
      "./styles.css": "./src/styles.css"
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./adapters": "./src/lib/adapters/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "README.md",
    "dist",
    "src/styles.css"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.6.0",
    "@remotion/captions": "4.0.491",
    "@remotion/gif": "4.0.491",
    "@remotion/google-fonts": "4.0.491",
    "@remotion/media": "4.0.491",
    "@remotion/player": "4.0.491",
    "lucide-react": "^1.25.0",
    "mediabunny": "^1.50.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.491",
    "zustand": "^5.0.0"
  },
  "dependencies": {
    "@gedatou/shared": "workspace:*",
    "class-variance-authority": "catalog:ui",
    "clsx": "catalog:ui",
    "cmdk": "catalog:ui",
    "tailwind-merge": "catalog:ui"
  },
  "devDependencies": {
    "@base-ui/react": "catalog:ui",
    "@remotion/captions": "catalog:remotion",
    "@remotion/gif": "catalog:remotion",
    "@remotion/google-fonts": "catalog:remotion",
    "@remotion/media": "catalog:remotion",
    "@remotion/player": "catalog:remotion",
    "@types/node": "catalog:types",
    "@types/react": "catalog:types",
    "@types/react-dom": "catalog:types",
    "lucide-react": "catalog:ui",
    "mediabunny": "catalog:remotion",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "remotion": "catalog:remotion",
    "tsdown": "catalog:cli",
    "typescript": "catalog:cli",
    "zustand": "catalog:ui"
  }
}
